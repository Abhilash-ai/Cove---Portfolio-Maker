# Database Connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5433/cove"

# Mandatory JWT signing secret (Required for server startup; no hardcoded fallback allowed)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_in_production"

# Port for Cove Express API
PORT=4000
NODE_ENV=development

# Comma-separated CORS allowed origins list
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173"
